# English. Brazilian Portuguese: secrets.example.pt-BR.env
# Copy to ~/.config/sambinha/secrets.env and protect it with chmod 600.
# Activate [backup].secrets_file in sambinha.toml to load this file automatically.
# Values already present in the terminal take precedence.

# Use a profile already configured in ~/.aws/credentials.
export AWS_PROFILE='sambinha'

# Alternatively, comment AWS_PROFILE above and use AWS credentials directly.
# export AWS_ACCESS_KEY_ID='YOUR_KEY'
# export AWS_SECRET_ACCESS_KEY='YOUR_SECRET'
# Only for temporary credentials:
# export AWS_SESSION_TOKEN='YOUR_TOKEN'

# Optional Cronitor notifications. Replace both placeholders before activating.
# export CRONITOR_URL='https://cronitor.link/p/YOUR_TOKEN/YOUR_MONITOR'

# Optional variables for ${NAME} references in paths in the TOML.
# export BACKUP_SOURCE='/mnt/dados/documentos'
# export BACKUP_DESTINATION='/mnt/backup/documentos'
# export BACKUP_SOURCE_MOUNT='/mnt/dados'
# export BACKUP_DESTINATION_MOUNT='/mnt/backup'
# export BACKUP_EXCLUDES='/home/YOUR_USER/.config/sambinha/excludes.txt'
