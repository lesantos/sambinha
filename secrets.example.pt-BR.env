# Português do Brasil. English: secrets.example.env
# Copie para ~/.config/sambinha/secrets.env e proteja com chmod 600.
# Ative [backup].secrets_file no sambinha.toml para ler este arquivo automaticamente.
# Valores já presentes no terminal têm prioridade.

# Use um perfil já configurado em ~/.aws/credentials.
export AWS_PROFILE='sambinha'

# Como alternativa, comente AWS_PROFILE acima e use as credenciais AWS diretamente.
# export AWS_ACCESS_KEY_ID='SUA_CHAVE'
# export AWS_SECRET_ACCESS_KEY='SEU_SEGREDO'
# Somente para credenciais temporárias:
# export AWS_SESSION_TOKEN='SEU_TOKEN'

# Notificações opcionais do Cronitor. Substitua os dois placeholders antes de ativar.
# export CRONITOR_URL='https://cronitor.link/p/SEU_TOKEN/SEU_MONITOR'

# Variáveis opcionais para referências ${NOME} nos caminhos do TOML.
# export BACKUP_SOURCE='/mnt/dados/documentos'
# export BACKUP_DESTINATION='/mnt/backup/documentos'
# export BACKUP_SOURCE_MOUNT='/mnt/dados'
# export BACKUP_DESTINATION_MOUNT='/mnt/backup'
# export BACKUP_EXCLUDES='/home/SEU_USUARIO/.config/sambinha/excludes.txt'
